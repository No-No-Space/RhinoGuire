<UserControl x:Class="RhinoGuire.Plugin.SpikePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="340"
             Background="{DynamicResource SurfacePageBrush}">
    <!-- WP-0 spike panel: the manual checks for Gate 0. Automated checks live in RGSpikeTest. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PanelPadding}">
            <TextBlock x:Name="HeadingText" Text="RhinoGuire spike" Style="{DynamicResource Tool.Text.Title}" />
            <TextBlock Text="Manual checks for Gate 0. The automated checks run with the RGSpikeTest command."
                       Style="{DynamicResource Tool.Text.Secondary}" Margin="0,4,0,0" />

            <TextBlock Text="1 · TYPING" Style="{DynamicResource Tool.Text.Eyebrow}" Margin="0,16,0,4" />
            <TextBlock Style="{DynamicResource Tool.Text.Secondary}"
                       Text="Click in the box, type a few letters, then press Enter. The letters should appear here, not on Rhino's command line, and Enter should not run a command." />
            <TextBox x:Name="SpikeTextBox" Margin="0,8,0,0" />

            <TextBlock Text="2 · PICK FROM A PANEL BUTTON" Style="{DynamicResource Tool.Text.Eyebrow}" Margin="0,16,0,4" />
            <TextBlock Style="{DynamicResource Tool.Text.Secondary}"
                       Text="Click the button, then click any object in a viewport. Its id should appear below and Rhino should stay responsive." />
            <Button x:Name="PickButton" Content="Pick object" Style="{DynamicResource Tool.Button.Primary}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnPickObjectClicked" />
            <TextBlock x:Name="PickStatusText" Text="No object picked." Style="{DynamicResource Tool.Text.Caption}" Margin="0,6,0,0" />

            <TextBlock Text="3 · THEME" Style="{DynamicResource Tool.Text.Eyebrow}" Margin="0,16,0,4" />
            <Button x:Name="ThemeButton" Content="Toggle dark / light" HorizontalAlignment="Left" Click="OnToggleThemeClicked" />
            <TextBlock x:Name="ThemeStatusText" Text="Theme: light" Style="{DynamicResource Tool.Text.Caption}" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
