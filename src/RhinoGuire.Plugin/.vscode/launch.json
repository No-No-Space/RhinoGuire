{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rhino 8 - netcore",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "C:\\Program Files\\Rhino 8\\System\\Rhino.exe",
      "args": ["/netcore"],
      "env": {
        "RHINO_PACKAGE_DIRS": "${workspaceFolder}/bin/Debug"
      },
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}
