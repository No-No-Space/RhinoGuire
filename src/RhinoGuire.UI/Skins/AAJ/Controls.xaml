<!-- AAJ skin: control styles and templates.
     The look follows AAJ's components/bundle.css: 2px borders, square corners, the state lives in the
     fill (hover one step, pressed two), optional 4px hard shadow on primary buttons, 2px focus ring.
     Every colour, font and size comes from the skin tokens through {DynamicResource}; the named styles
     are the contract in docs/port/SKIN_CONTRACT.md. Literal numbers here are AAJ geometry that has no
     token (e.g. the focus ring's -4 margin = -(FocusRingOffset + FocusRingWidth)). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:RhinoGuire.UI.Controls">

    <!-- ═══════════════════════════════════════════════════════════ Text ══ -->

    <Style x:Key="Tool.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Tool.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Tool.Text.Body}">
        <Setter Property="FontFamily" Value="{DynamicResource FontHeading}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH2}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
    </Style>

    <Style x:Key="Tool.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Tool.Text.Body}">
        <Setter Property="FontFamily" Value="{DynamicResource FontHeading}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH3}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Tool.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Tool.Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Mono label, AAJ field-label style. Type it in capitals: WPF has no text-transform. -->
    <Style x:Key="Tool.Text.Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Tool.Text.Body}">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeEyebrow}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightEyebrow}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Tool.Text.Figure" TargetType="TextBlock" BasedOn="{StaticResource Tool.Text.Body}">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightFigure}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Tool.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Tool.Text.Body}">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightEyebrow}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ═════════════════════════════════════════════════ Rule and card ══ -->

    <!-- AAJ: vertical rhythm comes from 2px rules. -->
    <Style x:Key="Tool.Rule" TargetType="Separator">
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="{DynamicResource LineThickness}" Background="{DynamicResource BorderControlBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tool.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderWidthThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
        <Setter Property="Padding" Value="{DynamicResource PanelPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ Buttons ══ -->

    <!-- Shared by primary, secondary and icon buttons: hard shadow, face, focus ring.
         Hover and pressed fills come from ctl:ControlColors set by each style. -->
    <ControlTemplate x:Key="Aaj.ButtonTemplate" TargetType="ButtonBase">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Shadow" Background="{DynamicResource AajShadowBrush}"
                    Margin="{DynamicResource AajShadowMargin}" Visibility="{DynamicResource AajButtonShadowVisibility}" />
            <Grid x:Name="FaceHost" Margin="{DynamicResource AajButtonFaceMargin}">
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius}">
                    <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
                <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                        BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="ctl:StatePreview.State" Value="Hover">
                <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="Foreground" Value="{Binding Path=(ctl:ControlColors.PressedForeground), RelativeSource={RelativeSource Self}}" />
                <Setter TargetName="FaceHost" Property="Margin" Value="{DynamicResource AajButtonFacePressedMargin}" />
                <Setter TargetName="Shadow" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="ctl:StatePreview.State" Value="Pressed">
                <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="Foreground" Value="{Binding Path=(ctl:ControlColors.PressedForeground), RelativeSource={RelativeSource Self}}" />
                <Setter TargetName="FaceHost" Property="Margin" Value="{DynamicResource AajButtonFacePressedMargin}" />
                <Setter TargetName="Shadow" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource DisabledBgBrush}" />
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ButtonDisabledBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                <Setter TargetName="Shadow" Property="Visibility" Value="Hidden" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
            <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Aaj.ButtonBase" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource FontHeading}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        <Setter Property="FontSize" Value="{DynamicResource AajFontSizeButton}" />
        <Setter Property="Padding" Value="{DynamicResource AajButtonPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderWidthThickness}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource Aaj.ButtonTemplate}" />
    </Style>

    <!-- One per panel: the action the panel exists for. Carbón fill, Hueso text. -->
    <Style x:Key="Tool.Button.Primary" TargetType="Button" BasedOn="{StaticResource Aaj.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource UiDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UiOnBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="ctl:ControlColors.HoverBackground" Value="{DynamicResource UiHoverBrush}" />
        <Setter Property="ctl:ControlColors.PressedBackground" Value="{DynamicResource UiPressedBrush}" />
        <Setter Property="ctl:ControlColors.PressedForeground" Value="{DynamicResource UiOnPressedBrush}" />
    </Style>

    <Style x:Key="Tool.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Aaj.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
        <Setter Property="ctl:ControlColors.HoverBackground" Value="{DynamicResource ButtonSecondaryBgHoverBrush}" />
        <Setter Property="ctl:ControlColors.PressedBackground" Value="{DynamicResource ButtonSecondaryBgPressedBrush}" />
        <Setter Property="ctl:ControlColors.PressedForeground" Value="{DynamicResource TextPrimaryBrush}" />
        <!-- AAJ keeps the hard shadow for primary buttons. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Pressed">
                            <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource DisabledBgBrush}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ButtonDisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tool.Button.Primary.Small" TargetType="Button" BasedOn="{StaticResource Tool.Button.Primary}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
        <Setter Property="Padding" Value="{DynamicResource AajButtonPaddingSmall}" />
        <Setter Property="FontSize" Value="{DynamicResource AajFontSizeButtonSmall}" />
    </Style>

    <Style x:Key="Tool.Button.Secondary.Small" TargetType="Button" BasedOn="{StaticResource Tool.Button.Secondary}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
        <Setter Property="Padding" Value="{DynamicResource AajButtonPaddingSmall}" />
        <Setter Property="FontSize" Value="{DynamicResource AajFontSizeButtonSmall}" />
    </Style>

    <!-- "Show all"-type actions: no fill, no border; a Mar Caribe rule lights up under the label. -->
    <Style x:Key="Tool.Button.Text" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontHeading}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        <Setter Property="FontSize" Value="{DynamicResource AajFontSizeButtonSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <StackPanel VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Left" />
                            <Border x:Name="Underline" Height="{DynamicResource LineThickness}" Margin="0,3,0,0" Background="Transparent" />
                        </StackPanel>
                        <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource ButtonTextUnderlineBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonTextHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource ButtonTextUnderlineBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonTextHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource ButtonTextUnderlineBrush}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonTextPressedBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Pressed">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonTextPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                            <Setter TargetName="Underline" Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tool.Button.Text.Small" TargetType="Button" BasedOn="{StaticResource Tool.Button.Text}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeEyebrow}" />
    </Style>

    <!-- Square secondary button holding a ctl:Icon. Give it a ToolTip: an icon alone is not a label. -->
    <Style x:Key="Tool.Button.Icon" TargetType="Button" BasedOn="{StaticResource Tool.Button.Secondary}">
        <Setter Property="MinWidth" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Tool.Button.Icon.Small" TargetType="Button" BasedOn="{StaticResource Tool.Button.Icon}">
        <Setter Property="MinWidth" Value="{DynamicResource ControlHeightSmall}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
    </Style>

    <!-- Toggle (AAJ "selected"): secondary at rest, inverted while checked. -->
    <Style x:Key="Tool.ToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource Aaj.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
        <Setter Property="ctl:ControlColors.HoverBackground" Value="{DynamicResource ButtonSecondaryBgHoverBrush}" />
        <Setter Property="ctl:ControlColors.PressedBackground" Value="{DynamicResource ButtonSecondaryBgPressedBrush}" />
        <Setter Property="ctl:ControlColors.PressedForeground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="ctl:ControlColors.CheckedBackground" Value="{DynamicResource UiDefaultBrush}" />
        <Setter Property="ctl:ControlColors.CheckedForeground" Value="{DynamicResource UiOnBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{Binding Path=(ctl:ControlColors.CheckedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="{Binding Path=(ctl:ControlColors.CheckedForeground), RelativeSource={RelativeSource Self}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource DisabledBgBrush}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ButtonDisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ Fields ══ -->

    <!-- Fields sit on the lighter surface so what can be typed into reads at a glance.
         AAJ shows the focus ring on any focus, not only keyboard focus. -->
    <Style x:Key="Tool.Field" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ActivityDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderWidthThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource AajFontSizeField}" />
        <Setter Property="Padding" Value="{DynamicResource AajFieldPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <TextBlock x:Name="Placeholder" Text="{Binding Path=(ctl:Field.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0" IsHitTestVisible="False"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Style="{x:Null}" Background="Transparent"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource InputBgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource InputBgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:Field.State" Value="Error">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource StatusErrorSubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StatusErrorStrongBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:Field.State" Value="Warning">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource StatusWarningSubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StatusWarningStrongBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:Field.State" Value="Success">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource StatusSuccessSubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StatusSuccessStrongBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:Field.State" Value="Changed">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ActivitySubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActivityStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource InputBgFocusBrush}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DisabledBgBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Figures: right-aligned, mono, tabular. Put the unit in the label, not after the value. -->
    <Style x:Key="Tool.Field.Number" TargetType="TextBox" BasedOn="{StaticResource Tool.Field}">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightFigure}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Label, input, then a state message (icon + words, never colour alone) or help text. -->
    <Style x:Key="Tool.FieldFrame" TargetType="ctl:Field">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:Field">
                    <StackPanel>
                        <ContentPresenter x:Name="Label" ContentSource="Header" Margin="0,0,0,6" RecognizesAccessKey="True"
                                          TextElement.FontFamily="{DynamicResource FontMono}"
                                          TextElement.FontSize="{DynamicResource FontSizeEyebrow}"
                                          TextElement.FontWeight="{DynamicResource FontWeightEyebrow}"
                                          TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ContentPresenter />
                        <Grid x:Name="Message" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ctl:Icon x:Name="MessageIcon" Kind="Info" VerticalAlignment="Top" Margin="0,1,6,0" />
                            <TextBlock x:Name="MessageText" Grid.Column="1" Text="{TemplateBinding Message}" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource FontBody}" FontSize="{DynamicResource FontSizeBodySm}" />
                        </Grid>
                        <TextBlock x:Name="Help" Margin="0,6,0,0" Text="{TemplateBinding Help}" TextWrapping="Wrap"
                                   FontFamily="{DynamicResource FontBody}" FontSize="{DynamicResource FontSizeBodySm}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Help" Value="{x:Null}">
                            <Setter TargetName="Help" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Help" Value="">
                            <Setter TargetName="Help" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="State" Value="None">
                            <Setter TargetName="MessageIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Message" Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="Error">
                            <Setter TargetName="MessageIcon" Property="Kind" Value="CircleX" />
                            <Setter TargetName="Message" Property="TextElement.Foreground" Value="{DynamicResource StatusErrorStrongBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="Warning">
                            <Setter TargetName="MessageIcon" Property="Kind" Value="TriangleAlert" />
                            <Setter TargetName="Message" Property="TextElement.Foreground" Value="{DynamicResource StatusWarningStrongBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="Success">
                            <Setter TargetName="MessageIcon" Property="Kind" Value="CircleCheck" />
                            <Setter TargetName="Message" Property="TextElement.Foreground" Value="{DynamicResource StatusSuccessStrongBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="Changed">
                            <Setter TargetName="MessageIcon" Property="Kind" Value="Pencil" />
                            <Setter TargetName="Message" Property="TextElement.Foreground" Value="{DynamicResource ActivityStrongBrush}" />
                        </Trigger>
                        <!-- No message: hide it. A message replaces the help text. -->
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="Message" Property="Visibility" Value="Visible">
                            <Setter TargetName="Help" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ Select ══ -->

    <Style x:Key="Aaj.ComboEditor" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ActivityDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Style="{x:Null}" Background="Transparent"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tool.Select" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderWidthThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource AajFontSizeField}" />
        <Setter Property="Padding" Value="{DynamicResource AajFieldPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius}" />
                        <ToggleButton x:Name="Toggle" Style="{x:Null}" Focusable="False" ClickMode="Press" Cursor="Hand" Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <ctl:Icon Kind="ChevronDown" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{DynamicResource Aaj.ComboEditor}" Visibility="Hidden"
                                 Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Padding="0,0,28,0"
                                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                 Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" />
                        <TextBlock x:Name="Placeholder" Text="{Binding Path=(ctl:Field.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border x:Name="DropDown" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderControlBrush}"
                                    BorderThickness="{DynamicResource ControlBorderWidthThickness}" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            <!-- Only the chevron opens the list; the rest of the box is for typing. -->
                            <Setter TargetName="Toggle" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Toggle" Property="Width" Value="40" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="SelectedItem" Value="{x:Null}" />
                                <Condition Property="IsEditable" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource InputBgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource InputBgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:Field.State" Value="Error">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource StatusErrorSubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StatusErrorStrongBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:Field.State" Value="Warning">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource StatusWarningSubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StatusWarningStrongBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:Field.State" Value="Success">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource StatusSuccessSubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StatusSuccessStrongBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:Field.State" Value="Changed">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ActivitySubtleBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActivityStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource InputBgFocusBrush}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDown" Property="MinHeight" Value="24" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DisabledBgBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tool.Select.Item" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Padding" Value="{DynamicResource AajListItemPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource UiSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectionDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectionOnBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════ Check, radio, switch ══ -->

    <Style x:Key="Aaj.ChoiceBase" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Checked inverts: Carbón box, Hueso tick. -->
    <Style x:Key="Tool.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource Aaj.ChoiceBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="{DynamicResource AajChoiceSize}" Height="{DynamicResource AajChoiceSize}" VerticalAlignment="Center">
                            <Border x:Name="Box" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderControlBrush}"
                                    BorderThickness="{DynamicResource ControlBorderWidthThickness}" CornerRadius="{DynamicResource Radius}" />
                            <ctl:Icon x:Name="Tick" Kind="Check" Size="14" StrokeThickness="2.5" Foreground="{DynamicResource UiOnBrush}" Visibility="Collapsed" />
                            <Border x:Name="Dash" Width="10" Height="2" Background="{DynamicResource UiOnBrush}" Visibility="Collapsed" />
                            <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                                    BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource UiSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource UiSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource UiDefaultBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource UiDefaultBrush}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DisabledBgBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            <Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                            <Setter TargetName="Dash" Property="Background" Value="{DynamicResource DisabledFgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio buttons are the one round control in AAJ. -->
    <Style x:Key="Tool.Radio" TargetType="RadioButton" BasedOn="{StaticResource Aaj.ChoiceBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="{DynamicResource AajChoiceSize}" Height="{DynamicResource AajChoiceSize}" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{DynamicResource InputBgBrush}" Stroke="{DynamicResource BorderControlBrush}"
                                     StrokeThickness="{DynamicResource ControlBorderWidth}" />
                            <Ellipse x:Name="Dot" Margin="5" Fill="{DynamicResource UiDefaultBrush}" Visibility="Collapsed" />
                            <Ellipse x:Name="FocusRing" Margin="-4" Stroke="{DynamicResource FocusRingBrush}"
                                     StrokeThickness="{DynamicResource FocusRingWidth}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource UiSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource UiSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource DisabledBgBrush}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource DisabledBorderBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource DisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- For settings that apply at once. On, the track turns Mar Caribe (activity). -->
    <Style x:Key="Tool.Switch" TargetType="CheckBox" BasedOn="{StaticResource Aaj.ChoiceBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderControlBrush}"
                                    BorderThickness="{DynamicResource ControlBorderWidthThickness}" CornerRadius="{DynamicResource Radius}" />
                            <Border x:Name="Knob" Width="16" Height="16" Margin="4,0" HorizontalAlignment="Left"
                                    Background="{DynamicResource UiDefaultBrush}" BorderBrush="{DynamicResource BorderControlBrush}"
                                    CornerRadius="{DynamicResource Radius}" />
                            <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                                    BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource UiSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource UiSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ActivityDefaultBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource InputBgBrush}" />
                            <Setter TargetName="Knob" Property="BorderThickness" Value="{DynamicResource ControlBorderWidthThickness}" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource DisabledBgBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource DisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════ Tabs ══ -->

    <!-- Tabs fused to their panel; the active tab inverts. -->
    <Style x:Key="Tool.Tabs" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderWidthThickness}" />
        <Setter Property="Padding" Value="{DynamicResource AajTabPanelPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Panel.ZIndex="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tool.Tab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontHeading}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
        <Setter Property="FontSize" Value="{DynamicResource AajFontSizeTab}" />
        <Setter Property="Padding" Value="{DynamicResource AajTabPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource AajTabHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- -2 right: neighbouring tabs share a border. -->
                    <Grid Margin="0,0,-2,0">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2,2,2,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonSecondaryBgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonSecondaryBgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource UiDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource UiOnBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource DisabledBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ List, expander ══ -->

    <Style x:Key="Tool.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderWidthThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tool.ListBox.Item" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="{DynamicResource AajListItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource UiSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource UiSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectionDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectionOnBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Disclosure for advanced settings: chevron + heading, no frame. -->
    <Style x:Key="Tool.Expander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="Header" DockPanel.Dock="Top" Style="{x:Null}" Cursor="Hand" Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      MinHeight="{DynamicResource ControlHeightSmall}" FocusVisualStyle="{x:Null}"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ctl:Icon x:Name="Chevron" Kind="ChevronRight" Margin="0,0,8,0" />
                                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
                                                              TextElement.FontFamily="{DynamicResource FontHeading}"
                                                              TextElement.FontWeight="{DynamicResource FontWeightHeading}"
                                                              TextElement.FontSize="{DynamicResource AajFontSizeButton}" />
                                        </StackPanel>
                                        <Border x:Name="FocusRing" Margin="-4" BorderBrush="{DynamicResource FocusRingBrush}"
                                                BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Kind" Value="ChevronDown" />
                                        </Trigger>
                                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Margin="0,8,0,0" Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════ Scrolling and tooltip ══ -->

    <Style x:Key="Aaj.ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="2" Background="{DynamicResource AajScrollThumbBrush}" CornerRadius="{DynamicResource Radius}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AajScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AajScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Aaj.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin bars, no arrows: the thumb is a flat Tierra block that darkens on hover. -->
    <Style x:Key="Tool.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Aaj.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Aaj.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Aaj.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Aaj.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Aaj.ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Aaj.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tool.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No drop shadow anywhere in AAJ except the hard offsets. -->
    <Style x:Key="Tool.ToolTip" TargetType="ToolTip">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource ChartTooltipBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChartTooltipFgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderWidthThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" MaxWidth="320">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ Tables ══ -->

    <!-- Carbón header in Fliege Mono, 12px body, figures right-aligned in Fliege Mono 300. -->
    <Style x:Key="Tool.Table" TargetType="ctl:TreeDataGrid">
        <Setter Property="Background" Value="{DynamicResource TableRowBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderWidthThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTable}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:TreeDataGrid">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border x:Name="PART_HeaderHost" DockPanel.Dock="Top" />
                            <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row kinds read apart: total (2px rule, heavy) › subtotal (1px rule, heavy) › data (alternating). -->
    <Style x:Key="Tool.Table.Row" TargetType="ctl:TreeDataGridRow">
        <Setter Property="Background" Value="{DynamicResource TableRowBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:TreeDataGridRow">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource TableRuleBrush}" BorderThickness="0,0,0,1" />
                        <Border x:Name="TopRule" VerticalAlignment="Top" Height="0" />
                        <ContentPresenter />
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="{DynamicResource FocusRingWidthThickness}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsAlternate" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TableRowAltBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Subtotal">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TableSubtotalBgBrush}" />
                            <Setter TargetName="TopRule" Property="Height" Value="{DynamicResource LineThicknessThin}" />
                            <Setter TargetName="TopRule" Property="Background" Value="{DynamicResource TableSubtotalRuleBrush}" />
                            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Total">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TableTotalBgBrush}" />
                            <Setter TargetName="TopRule" Property="Height" Value="{DynamicResource LineThickness}" />
                            <Setter TargetName="TopRule" Property="Background" Value="{DynamicResource TableTotalRuleBrush}" />
                            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TableRowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:StatePreview.State" Value="Hover">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TableRowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TableRowSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TableRowSelectedFgBrush}" />
                        </Trigger>
                        <Trigger Property="ctl:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tool.Table.Cell" TargetType="ctl:TreeDataGridCell">
        <Setter Property="Padding" Value="{DynamicResource AajCellPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:TreeDataGridCell">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChanged" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TableCellChangedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsNumeric" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeightFigure}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsNumeric" Value="True" />
                    <Condition Property="Kind" Value="Subtotal" />
                </MultiTrigger.Conditions>
                <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsNumeric" Value="True" />
                    <Condition Property="Kind" Value="Total" />
                </MultiTrigger.Conditions>
                <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tool.Table.HeaderCell" TargetType="ctl:TreeDataGridHeaderCell">
        <Setter Property="Background" Value="{DynamicResource TableHeaderBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TableHeaderFgBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
        <Setter Property="FontWeight" Value="{DynamicResource AajFontWeightTableHeader}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeEyebrow}" />
        <Setter Property="Padding" Value="{DynamicResource AajCellPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource TableHeaderHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:TreeDataGridHeaderCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsNumeric" Value="True">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tool.Table.Expander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <ctl:Icon x:Name="Chevron" Kind="ChevronRight" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Kind" Value="ChevronDown" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════ Status and busy ══ -->

    <!-- Status always pairs an icon and a word with its colour; the message itself stays in text colour. -->
    <Style x:Key="Tool.StatusLine" TargetType="ctl:StatusLine">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:StatusLine">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ctl:Icon x:Name="StatusIcon" Kind="Info" VerticalAlignment="Top" Margin="0,1,6,0" />
                        <TextBlock x:Name="Word" Grid.Column="1" Text="{TemplateBinding DisplayWord}" Margin="0,0,6,0"
                                   FontWeight="{DynamicResource FontWeightStrong}" VerticalAlignment="Top" />
                        <TextBlock x:Name="Message" Grid.Column="2" Text="{TemplateBinding Text}" TextWrapping="Wrap"
                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Top" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="None">
                            <Setter TargetName="StatusIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Word" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Info">
                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusInfoStrongBrush}" />
                            <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource StatusInfoStrongBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Success">
                            <Setter TargetName="StatusIcon" Property="Kind" Value="CircleCheck" />
                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusSuccessStrongBrush}" />
                            <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource StatusSuccessStrongBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Warning">
                            <Setter TargetName="StatusIcon" Property="Kind" Value="TriangleAlert" />
                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusWarningStrongBrush}" />
                            <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource StatusWarningStrongBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Error">
                            <Setter TargetName="StatusIcon" Property="Kind" Value="CircleX" />
                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusErrorStrongBrush}" />
                            <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource StatusErrorStrongBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Busy">
                            <Setter TargetName="StatusIcon" Property="Kind" Value="LoaderCircle" />
                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ActivityStrongBrush}" />
                            <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource ActivityStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tool.BusyBar" TargetType="ctl:BusyBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:BusyBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" Background="{DynamicResource BorderSubtleBrush}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource ActivityDefaultBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════ Implicit (type) styles ══
         So nothing in a panel falls back to WPF's default chrome. Plain buttons are secondary:
         a panel opts into its one primary action with Tool.Button.Primary. -->

    <Style TargetType="Button" BasedOn="{StaticResource Tool.Button.Secondary}" />
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Tool.ToggleButton}" />
    <Style TargetType="TextBox" BasedOn="{StaticResource Tool.Field}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource Tool.Select}" />
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Tool.Select.Item}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource Tool.CheckBox}" />
    <Style TargetType="RadioButton" BasedOn="{StaticResource Tool.Radio}" />
    <Style TargetType="TabControl" BasedOn="{StaticResource Tool.Tabs}" />
    <Style TargetType="TabItem" BasedOn="{StaticResource Tool.Tab}" />
    <Style TargetType="ListBox" BasedOn="{StaticResource Tool.ListBox}" />
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Tool.ListBox.Item}" />
    <Style TargetType="Expander" BasedOn="{StaticResource Tool.Expander}" />
    <Style TargetType="Separator" BasedOn="{StaticResource Tool.Rule}" />
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Tool.ScrollBar}" />
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource Tool.ScrollViewer}" />
    <Style TargetType="ToolTip" BasedOn="{StaticResource Tool.ToolTip}" />
    <Style TargetType="ctl:Field" BasedOn="{StaticResource Tool.FieldFrame}" />
    <Style TargetType="ctl:StatusLine" BasedOn="{StaticResource Tool.StatusLine}" />
    <Style TargetType="ctl:BusyBar" BasedOn="{StaticResource Tool.BusyBar}" />
    <Style TargetType="ctl:KeySearchComboBox" BasedOn="{StaticResource Tool.Select}">
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="IsTextSearchEnabled" Value="False" />
        <Setter Property="StaysOpenOnEdit" Value="True" />
    </Style>
    <Style TargetType="ctl:TreeDataGrid" BasedOn="{StaticResource Tool.Table}" />
    <Style TargetType="ctl:TreeDataGridRow" BasedOn="{StaticResource Tool.Table.Row}" />
    <Style TargetType="ctl:TreeDataGridCell" BasedOn="{StaticResource Tool.Table.Cell}" />
    <Style TargetType="ctl:TreeDataGridHeaderCell" BasedOn="{StaticResource Tool.Table.HeaderCell}" />
</ResourceDictionary>
