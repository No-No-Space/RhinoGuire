<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- WP-0 spike subset, values from _Skills/AAJ Design System/tokens.json.
         WP-1A replaces this file with the output of tools/build_aaj_skin.py. -->

    <Color x:Key="ColorSurfacePage">#F2EDE6</Color>      <!-- bg-page (Hueso) -->
    <SolidColorBrush x:Key="SurfacePage" Color="{StaticResource ColorSurfacePage}" />

    <Color x:Key="ColorSurfaceSubtle">#FBF9F5</Color>    <!-- bg-surface -->
    <SolidColorBrush x:Key="SurfaceSubtle" Color="{StaticResource ColorSurfaceSubtle}" />

    <Color x:Key="ColorTextPrimary">#2A2725</Color>      <!-- text-primary (Carbón) -->
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ColorTextPrimary}" />

    <Color x:Key="ColorTextSecondary">#8A8580</Color>    <!-- text-secondary (Tierra) -->
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextSecondary}" />

    <Color x:Key="ColorBorderControl">#2A2725</Color>    <!-- color-border -->
    <SolidColorBrush x:Key="BorderControl" Color="{StaticResource ColorBorderControl}" />

    <Color x:Key="ColorUiDefault">#2A2725</Color>        <!-- primary button fill -->
    <SolidColorBrush x:Key="UiDefault" Color="{StaticResource ColorUiDefault}" />

    <Color x:Key="ColorUiOn">#F2EDE6</Color>             <!-- text on primary fill -->
    <SolidColorBrush x:Key="UiOn" Color="{StaticResource ColorUiOn}" />

    <Color x:Key="ColorFocusRing">#2A8B9C</Color>        <!-- focus-ring (Mar Caribe) -->
    <SolidColorBrush x:Key="FocusRing" Color="{StaticResource ColorFocusRing}" />
</ResourceDictionary>
